# DC script: array multiplier, N=32
# Generated by dse_sweep.py

set design array_32x32
set rtl_file "/Users/victor/ece527/lab2/TaskC/dse/rtl/array_32x32.sv"
set lib "/Users/victor/ece527/lab2/TaskC/lib/gscl45nm.db"

set_app_var search_path  [list .]
set_app_var target_library $lib
set_app_var link_library   "* $lib"

read_file -format sverilog $rtl_file
current_design array_32x32
link
check_design

# Constraints (loose max delay to get intrinsic critical path)
set_max_delay 100 -from [all_inputs] -to [all_outputs]
set_load 0.5 [all_outputs]

if {[catch {set_switching_activity -static_probability 0.5 -toggle_rate 0.2 [all_inputs]} msg]} {
    puts "WARNING: set_switching_activity failed: $msg"
}

# Synthesize
compile -map_effort high

# Reports
redirect reports/array_32_area.rpt      { report_area }
redirect reports/array_32_qor.rpt       { report_qor }
redirect reports/array_32_reference.rpt { report_reference }
redirect reports/array_32_timing.rpt    { report_timing -delay_type max -max_paths 5 -nworst 5 -from [all_inputs] -to [all_outputs] }
redirect reports/array_32_power.rpt     { report_power -analysis_effort high }

# Outputs
write -format verilog -hierarchy -output netlists/array_32.v
write -format ddc     -hierarchy -output netlists/array_32.ddc

exit
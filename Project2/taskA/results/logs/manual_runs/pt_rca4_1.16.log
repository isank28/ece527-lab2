set R2R_FROM [all_registers -clock_pins]
{"S_reg[1]/CLK", "B_reg_reg[2]/CLK", "A_reg_reg[2]/CLK", "S_reg[0]/CLK", "Cout_reg/CLK", "A_reg_reg[1]/CLK", "B_reg_reg[1]/CLK", "S_reg[3]/CLK", "Cin_reg_reg/CLK", "B_reg_reg[0]/CLK", "A_reg_reg[0]/CLK", "S_reg[2]/CLK", "B_reg_reg[3]/CLK", "A_reg_reg[3]/CLK"}
set R2R_TO   [all_registers -data_pins]
{"S_reg[1]/D", "B_reg_reg[2]/D", "A_reg_reg[2]/D", "S_reg[0]/D", "Cout_reg/D", "A_reg_reg[1]/D", "B_reg_reg[1]/D", "S_reg[3]/D", "Cin_reg_reg/D", "B_reg_reg[0]/D", "A_reg_reg[0]/D", "S_reg[2]/D", "B_reg_reg[3]/D", "A_reg_reg[3]/D"}
set fh  [open reports/${DESIGN}_pt_skew_sweep.txt w]
file28
set hdr [format "%-6s %11s %11s %11s %11s %10s %10s"          skew setup_all hold_all setup_r2r hold_r2r Tmin_all Tmin_r2r]
skew     setup_all    hold_all   setup_r2r    hold_r2r   Tmin_all   Tmin_r2r
puts "\nSkew sweep ($SKEW_MODE mode, period $CLK_PERIOD ns)"

Skew sweep (uncertainty mode, period 1.16 ns)
puts $hdr
skew     setup_all    hold_all   setup_r2r    hold_r2r   Tmin_all   Tmin_r2r
puts $fh "Skew sweep ($SKEW_MODE mode, period $CLK_PERIOD ns)"
puts $fh $hdr
foreach s $SKEW_SWEEP {
    apply_skew $s
    set su_all [slack_of -delay_type max]
    set ho_all [slack_of -delay_type min]
    set su_r2r [slack_of -delay_type max -from $R2R_FROM -to $R2R_TO]
    set ho_r2r [slack_of -delay_type min -from $R2R_FROM -to $R2R_TO]
    set tmin_all [expr {[string is double -strict $su_all] ? $CLK_PERIOD - $su_all : ""}]
    set tmin_r2r [expr {[string is double -strict $su_r2r] ? $CLK_PERIOD - $su_r2r : ""}]
    set line [format "%-6s %11s %11s %11s %11s %10s %10s" $s               [fmt $su_all] [fmt $ho_all] [fmt $su_r2r] [fmt $ho_r2r] [fmt $tmin_all] [fmt $tmin_r2r]]
    puts $line
    puts $fh $line
}
